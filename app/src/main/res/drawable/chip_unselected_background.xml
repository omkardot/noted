<?xml version="1.0" encoding="utf-8"?>
    <!-- This drawable provides a light gray background with rounded corners for unselected state. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
android:shape="rectangle">

<!-- Solid color equivalent to Tailwind 'bg-gray-200' -->
<solid android:color="#FFE0E0E0" />

<!-- Rounded corners equivalent to 'rounded-full' -->
<corners android:radius="12dp" />

<!-- Optional: A slight border for better definition -->
<stroke
    android:width="1dp"
    android:color="#FFD1D5DB" />
</shape>