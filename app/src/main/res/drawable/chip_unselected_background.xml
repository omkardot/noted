<?xml version="1.0" encoding="utf-8"?>
<!-- This drawable provides the LinkedIn Blue background with rounded corners for the selected state. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Solid color using the LINKEDIN_BLUE constant defined in the Canvas -->
    <solid android:color="#FF0A66C2" />

    <!-- Rounded corners equivalent to 'rounded-full' -->
    <corners android:radius="12dp" />
</shape>