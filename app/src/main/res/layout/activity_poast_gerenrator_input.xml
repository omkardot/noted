<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".View.PoastGerenratorInput">

    <ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_light"

        android:padding="16dp">

        <!-- Main Vertical Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="48dp"
            tools:context=".MainActivity">

            <!-- 1. Headline and Subtitle Block -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Share what you learned today 💡"
                    android:textSize="22sp"
                    android:fontFamily="@font/poppins_bold"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:text="Turn your learning moments into professional LinkedIn posts."
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    />
            </LinearLayout>

            <!-- 2. AI Assistant Prompt Box (Inline Instruction) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/rounded_blue_border"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <!-- Mock Icon for Aperture/Assistant -->
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/chatgpt"
                    android:tint="@color/accent_indigo"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="AI Icon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:text="Tell the AI assistant what you achieved or learned in a simple sentence."
                    android:textSize="12sp"
                    android:textColor="@color/primary_blue"
                 />
            </LinearLayout>


            <EditText
                android:id="@+id/input_text_area"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="5"
                android:gravity="top|start"
                android:text="i have learned ai"
                android:fontFamily="@font/poppins_regular"
                android:hint="I completed a course on C# generics and built a project using them."
                android:inputType="textMultiLine"
                android:padding="16dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:background="@drawable/edittext_background"

                android:textSize="16sp"
                android:layout_marginBottom="20dp" />

            <!-- Mock Drawable for EditText -->
            <!-- @drawable/edittext_background (Shape drawable: solid white, stroke gray_300, radius 12dp, subtle elevation) -->


            <!-- 4. Tone Selector Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tone"
                android:fontFamily="@font/poppins_bold"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#424A59"
                android:layout_marginBottom="8dp"/>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:clipToPadding="false">

                    <!-- Tone Chip 1 (Selected) -->

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="10dp"
                        android:layout_marginRight="10dp"
                        android:id="@+id/ll_professional"
                        android:background="@drawable/chip_selected_background"
                        >
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Professional"
                            android:id="@+id/tv_professional"
                            android:layout_gravity="center_vertical"
                            android:textColor="@color/white"
                            android:fontFamily="@font/poppins_regular"
                            />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="10dp"
                        android:id="@+id/ll_friendly"
                        android:layout_marginHorizontal="10dp"
                        android:background="@drawable/chip_unselected_background"
                        >
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Friendly"
                            android:id="@+id/tv_friendly"
                            android:layout_gravity="center"
                            android:textColor="@color/text_secondary"
                            android:fontFamily="@font/poppins_regular"
                            />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="10dp"
                        android:id="@+id/ll_story_telling"
                        android:layout_marginHorizontal="10dp"
                        android:background="@drawable/chip_unselected_background"
                        >
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Storytelling"
                            android:textColor="@color/text_secondary"
                            android:id="@+id/tv_story_telling"
                            android:fontFamily="@font/poppins_regular"
                            />
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>


            <!-- 5. Length Selector Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Length"
                android:textSize="14sp"
                android:fontFamily="@font/poppins_bold"
                android:textStyle="bold"
                android:textColor="#424A59"
                android:layout_marginBottom="8dp"/>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:clipToPadding="false">

                    <!-- Tone Chip 1 (Selected) -->

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="10dp"
                        android:id="@+id/ll_short"
                        android:layout_marginRight="10dp"
                        android:background="@drawable/chip_selected_background"
                        >
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Short"
                            android:id="@+id/tv_short"
                            android:textColor="@color/white"
                            android:fontFamily="@font/poppins_regular"
                            />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/ll_medium"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="10dp"
                        android:layout_marginHorizontal="10dp"
                        android:background="@drawable/chip_unselected_background"
                        >
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Medium"
                            android:id="@+id/tv_medium"
                            android:textColor="@color/text_secondary"
                            android:fontFamily="@font/poppins_regular"
                            />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="10dp"
                        android:id="@+id/ll_long"
                        android:layout_marginHorizontal="10dp"
                        android:background="@drawable/chip_unselected_background"
                        >
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Long"
                            android:id="@+id/tv_long"
                            android:textColor="@color/text_secondary"
                            android:fontFamily="@font/poppins_regular"
                            />
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Mock Drawable for Chips -->
            <!-- @drawable/chip_selected_background (Shape drawable: solid linkedin_blue, radius 20dp) -->
            <!-- @drawable/chip_unselected_background (Shape drawable: solid gray_200, radius 20dp) -->


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:id="@+id/ll_generate_btn"
                android:background="@drawable/rounded_background_blue">
                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleLarge"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/white"
                    android:layout_marginRight="15dp"
                    android:visibility="gone" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="Generate Post"
                    android:id="@+id/text_status"
                    android:textSize="18sp"
                    android:fontFamily="@font/poppins_bold"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    />
            </LinearLayout>



            <!-- Mock Icon for Send -->
            <!-- @drawable/ic_send -->

        </LinearLayout>
    </ScrollView>

</LinearLayout>