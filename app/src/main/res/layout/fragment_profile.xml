<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7FAFC"
    tools:context=".Fragements.ProfileFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="16dp"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        >
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical"
            android:id="@+id/action_back"
            android:src="@drawable/baseline_arrow_back_24"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="24sp"
            android:paddingEnd="40dp"
            android:text="Profile"
            android:textColor="#0D121C"
            android:layout_gravity="center"
            android:gravity="center"
            android:fontFamily="@font/poppins_bold"
            />


    </LinearLayout>
        <de.hdodenhof.circleimageview.CircleImageView
            android:layout_width="128dp"
            android:src="@drawable/baseline_person_24"
            android:layout_gravity="center"
            android:id="@+id/profileImage"
            android:layout_height="128dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Omkar Shripat"
            android:id="@+id/profile_name"
            android:textSize="20sp"
            android:paddingVertical="15dp"
            android:textColor="@color/black"
            android:fontFamily="@font/poppins_bold"
            android:layout_gravity="center"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="@color/black"
            android:layout_marginHorizontal="20dp"
            android:textSize="20dp"
            android:layout_marginTop="15sp"
            android:fontFamily="@font/poppins_bold"
            />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:id="@+id/ll_helpandsupport"
            android:layout_marginTop="10dp"
            android:layout_marginHorizontal="20dp"
            >
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center_vertical"
                android:src="@drawable/ic_help_neutral"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#0D121C"
                android:text="Help &amp; Support"
                android:layout_marginHorizontal="20dp"
                android:paddingVertical="15dp"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins_regular"
                />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingVertical="20dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Logout"
                android:gravity="center"
                android:layout_gravity="bottom"
                android:background="@drawable/gray_rounded_background"
                android:layout_marginHorizontal="20dp"
                android:paddingVertical="12dp"
                android:id="@+id/logout"
                android:textColor="@color/black"
                android:fontFamily="@font/poppins_bold"/>
        </LinearLayout>



    </LinearLayout>
</FrameLayout>