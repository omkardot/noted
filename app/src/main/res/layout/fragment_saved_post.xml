<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7FAFC"
    tools:context=".Fragements.SavedPostFragment">

    <!-- TODO: Update blank fragment layout -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="16dp"
            android:paddingLeft="16dp"
            >
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:id="@+id/action_back"
                android:src="@drawable/baseline_arrow_back_24"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="24sp"
                android:paddingEnd="40dp"
                android:text="Past Post"
                android:textColor="#0D121C"
                android:layout_gravity="center"
                android:gravity="center"
                android:fontFamily="@font/poppins_bold"
                />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:textSize="24sp"
            android:text="No post saved"
            android:textColor="#5A0D121C"
            android:layout_gravity="center"
            android:gravity="center"
            android:id="@+id/no_post_text"
            android:fontFamily="@font/poppins_bold"
            />

        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            tools:listitem="@layout/saved_post_item"
            android:id="@+id/post_recycleview"/>
    </LinearLayout>



</FrameLayout>