<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base custom theme (no Material default colors) -->
    <style name="Base.Theme.Noted" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/black</item>
        <item name="colorPrimaryDark">@color/black</item>
        <item name="colorAccent">@color/black</item>

        <!-- Control colors -->
        <item name="colorControlNormal">@color/gray_border</item>
        <item name="colorControlActivated">@color/black</item>

        <!-- Background and surface -->
        <item name="android:windowBackground">@color/white</item>
        <item name="android:textColor">@color/black</item>

        <!-- Use your custom font -->
        <item name="android:fontFamily">@font/poppins_regular</item>
    </style>

    <!-- Hint text style -->
    <style name="HintText" parent="TextAppearance.AppCompat">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@android:color/black</item>
    </style>

</resources>
